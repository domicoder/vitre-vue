{
  "name": "vitre-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 Starter Template with Vite (JavaScript) for mocking apps quickly.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --mode development",
    "dev:local": "vite --mode local",
    "dev:staging": "vite --mode staging",
    "build": "npm run build:prod",
    "build-only": "vite build",
    "build:dev": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "build-test": "npm run build:dev",
    "build-prod": "npm run build:prod",
    "preview": "vite preview",
    "preview:dev": "vite preview --mode development",
    "preview:staging": "vite preview --mode staging",
    "preview:prod": "vite preview --mode production",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@mdi/font": "^7.4.47",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0",
    "vuetify": "^4.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/vue3-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
